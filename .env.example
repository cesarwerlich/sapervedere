# PostHog Analytics (Saper Vedere project)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Lead Notifications: Email Destination
LEAD_NOTIFICATION_EMAIL=cesardw@gmail.com

# Email Sender via Resend (Requires verified domain on Resend, e.g. sapervedere.com.br)
LEAD_EMAIL_FROM=Saper Vedere Leads <contato@sapervedere.com.br>
RESEND_API_KEY=

# Lead Notifications: Instant Telegram Bot Alerts (Optional & free push notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Lead Webhook Integration (Optional, e.g. n8n, Zapier, Make, Slack, Discord)
LEAD_WEBHOOK_URL=

# Cloudflare Turnstile (Optional, create at dash.cloudflare.com for sapervedere.com.br)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Meta Pixel (Optional, add your dedicated Saper Vedere / Cesar pixel ID)
NEXT_PUBLIC_META_PIXEL_ID=
